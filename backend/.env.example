# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# SMTP Configuration for Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=your-email@gmail.com
SMTP_TO=recipient-email@gmail.com

# Database Configuration
CONNECTION_STRING=Data Source=/app/data/books.db

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5002

# JWT Configuration (IMPORTANT: Change this secret in production!)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_ISSUER=PoglavljeVlku
JWT_AUDIENCE=PoglavljeVlkuAdmin

# Admin Credentials (IMPORTANT: Change these in production!)
# For hashed password, use format: HASHED:$2a$11$... (BCrypt hash)
# Or plain text (not recommended): your-strong-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HASHED:$2a$11$92y8vZ3LKqh8JVxqXZd4xeXJGKZqP9X5VjN7.KGhKh7Z8d4xeXJGK

