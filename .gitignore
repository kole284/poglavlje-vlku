# Docker deployment files
docker-compose.override.yml

# SSL certificates (don't commit private keys)
nginx/ssl/*.pem
nginx/ssl/*.key

# Environment files with secrets - NEVER COMMIT THESE!
*.env
*.env.local
*.env.production
*.env.development
!*.env.example

# Backend specific
backend/.env*
!backend/.env.example

# Frontend specific  
frontend/.env*
!frontend/.env.example

# Backup files
backups/
*.backup
*.bak

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
