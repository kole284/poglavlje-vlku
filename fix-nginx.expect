#!/usr/bin/expect -f

set timeout 60

# Connect via SSH and fix nginx
spawn ssh vlkuadmin@89.167.2.121

# Handle different SSH prompts
expect {
    "Are you sure you want to continue connecting" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "r%Y^6L!2gZc\r"
    }
}

# Wait for shell prompt
expect {
    "$ " { }
    "# " { }
    timeout { puts "Timeout waiting for prompt"; exit 1 }
}

# Navigate and fix nginx
send "cd ~/poglavlje-vlku\r"
expect -re "\[#$\] "

send "docker compose stop nginx\r"
expect -re "\[#$\] "

send "docker compose rm -f nginx\r"
expect -re "\[#$\] "

send "docker compose up -d nginx\r"
expect -re "\[#$\] "

send "sleep 3\r"
expect -re "\[#$\] "

send "docker compose ps\r"
expect -re "\[#$\] "

send "exit\r"
expect eof
