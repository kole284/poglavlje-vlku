#!/usr/bin/expect -f

set timeout 300

# Connect to SSH
spawn ssh vlkuadmin@89.167.2.121

# Wait for password prompt
expect "password:"
send "r%Y^6L!2gZc\r"

# Wait for shell prompt
expect "$ " 

# Navigate to project directory and run deployment
send "cd /root/poglavlje-vlku\r"
expect "$ "

send "git pull origin main\r"
expect "$ "

send "docker compose down\r"
expect "$ "

send "docker compose down --rmi local\r"
expect "$ "

send "docker compose build --no-cache\r"
expect "$ "

send "docker compose up -d\r"
expect "$ "

send "sleep 10\r"
expect "$ "

send "docker compose ps\r"
expect "$ "

send "exit\r"
expect eof
